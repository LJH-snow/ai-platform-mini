APP_NAME=AI Platform Mini
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
# LOG_FILE=/var/log/ai-platform/app.log  (optional rotating file output)

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60

API_KEYS=sk-test-key-1:development,sk-test-key-2:testing,sk-admin-key-1:admin
ADMIN_API_KEYS=sk-admin-key-1
AUTH_ENABLED=true
AUTH_STORAGE=memory

# Conversation storage: memory is the default for single-process local
# development and does not survive backend restarts; use postgres to persist
# conversations across restarts and multiple workers.
CONVERSATION_STORAGE=memory

# Workflow storage: memory is the default for single-process local development
# and does not survive backend restarts; use postgres to persist LangGraph
# checkpoints and run metadata across restarts and multiple workers.
WORKFLOW_STORAGE=memory

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

QUOTA_DAILY_TOKENS=0
QUOTA_MONTHLY_TOKENS=0
# key = per-key limits (default); workspace = workspace-shared limits
QUOTA_SCOPE=key
QUOTA_RESERVATION_TTL_SECONDS=600
QUOTA_RESERVATION_RENEWAL_SECONDS=60

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiplatform
INITIAL_API_KEY=

RAG_ENABLED=false
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIMENSIONS=768
RAG_MAX_UPLOAD_BYTES=10000000
RAG_MAX_PDF_PAGES=100
RAG_MAX_DOCUMENT_CHARACTERS=1000000
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=10000
RAG_MAX_DISTANCE=0.35
RAG_EMBEDDING_TIMEOUT_SECONDS=60

MCP_ENABLED=false
MCP_SERVERS_JSON=

# OpenTelemetry (disabled by default; no collector dependency when off)
TELEMETRY_ENABLED=false
TELEMETRY_SERVICE_NAME=ai-platform-mini
TELEMETRY_EXPORTER=otlp
# TELEMETRY_SAMPLING_RATIO=1.0        # 0.0 (drop all) to 1.0 (keep all)
# TELEMETRY_METRICS_ENABLED=true
# OTLP endpoint may also be set via OTEL_EXPORTER_OTLP_ENDPOINT
TELEMETRY_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Hybrid search: vector-only by default (legacy byte-identical behavior);
# switch to hybrid after the golden-set gate confirms hybrid >= vector.
RAG_SEARCH_MODE=vector
RAG_RRF_K=60
# Prompt-injection safety: strict hides suspicious docs from retrieval;
# flag ingests them with a marker; off disables checks entirely.
RAG_SAFETY_MODE=strict
# Reranker: set RERANKER_API_KEY in your local .env (never committed) to
# enable Jina reranking; without it the NoopReranker is used.
RERANKER_API_KEY=
RERANKER_MODEL=jina-reranker-v2-base-multilingual
RERANKER_TIMEOUT_SECONDS=10
