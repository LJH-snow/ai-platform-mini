{
  "name": "ai-platform-mini-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "vite preview",
    "a11y:smoke": "node scripts/a11y-smoke.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "axe-core": "4.12.1",
    "jsdom": "26.1.0",
    "oxlint": "1.75.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "6.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
