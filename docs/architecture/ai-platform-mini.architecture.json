  "cards": [
    {
      "dot": "cyan",
      "title": "请求链路",
      "items": [
        "React/Vite 前端 + nginx 同源代理 /api · /v1 · /admin，无 CORS",
        "Telemetry → Context（request_id）→ RequestLogging 中间件链",
        "require_api_key + 滑窗限流 + 配额 reserve/settle 生命周期"
      ]
    },
    {
      "dot": "emerald",
      "title": "执行域",
      "items": [
        "AgentRuntime 有界循环：max_steps · token_budget · deadline",
        "MultiAgentService：Supervisor 拆分任务，Orchestrator 按依赖/并发/预算执行",
        "Tool Registry/Executor + MCP stdio 白名单",
        "RAG：safety → chunk → embed（Ollama nomic-embed-text）→ hybrid RRF"
      ]
    },
    {
      "dot": "violet",
      "title": "Provider 路由",
      "items": [
        "LLMProvider 统一 Protocol + 共享 httpx 连接池",
        "默认模型 → Ollama · gpt-* → OpenAI 兼容 · mock 离线测试"
      ]
    },
    {
      "dot": "amber",
      "title": "存储与可观测",
      "items": [
        "单进程组合根：lru_cache 容器 + Protocol 双仓储，三开关切 memory|postgres",
        "长期记忆按 workspace/user owner_scope 隔离并注入 Agent 上下文",
        "usage · 会话 · Agent Run · 审计 · Workflow/Memory 均可落 PostgreSQL",
        "OpenTelemetry trace/metrics → Jaeger · JSON 日志 + request_id"
      ]
    }
  ]
